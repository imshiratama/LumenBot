TG_TOKEN=123456789:replace_me
TARGET_X_ID=YourXUsername
TWITTERAPI_KEY=replace_me
ALLOWED_CHAT_IDS=-1001234567890

# 本地可运行：python -c "import secrets; print(secrets.token_urlsafe(32))"
# Telegram 密钥仅允许字母、数字、下划线、连字符。
TELEGRAM_WEBHOOK_SECRET=replace_with_random_32_chars
ADMIN_SETUP_SECRET=replace_with_random_32_chars

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me
QSTASH_TOKEN=replace_me
QSTASH_CURRENT_SIGNING_KEY=replace_me
QSTASH_NEXT_SIGNING_KEY=replace_me

# 可选：Vercel 自动使用 VERCEL_PROJECT_PRODUCTION_URL；自定义域名时建议明确填写。
# PUBLIC_BASE_URL=https://your-project.vercel.app

VERIFICATION_TIMEOUT_SECONDS=300
X_REQUEST_TIMEOUT_SECONDS=15
MAX_X_ATTEMPTS=5
X_RETRY_SECONDS=10
X_API_FAIL_OPEN=false
